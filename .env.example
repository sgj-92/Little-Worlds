# Leave these unset to run in local demo mode (no account, sample data, nothing leaves the device).
# Set them (locally in .env.local, or in Vercel → Settings → Environment Variables) for live mode.

# Public values — safe in the browser; row-level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Social sign-in buttons to show, once each provider is switched on in Supabase → Authentication → Providers.
# VITE_AUTH_PROVIDERS=google,apple

# Server-only secrets (Milestone 3+). Never prefix these with VITE_.
# SUPABASE_SECRET_KEY=
# STORY_LLM_API_KEY=
# TTS_API_KEY=
# IMAGE_API_KEY=
